{
  "expo": {
    "name": "Agents Chat",
    "slug": "agents-chat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["agents-chat", "letta-mobile"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.angussoftware.agentschat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004F50",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "package": "com.angussoftware.agentschat",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach screenshots or photos to a message for your agent to look at."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#161618",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
